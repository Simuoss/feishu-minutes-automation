# ========== 常驻 .env（不进配置表）==========

# 飞书应用凭证
FEISHU_APP_ID=cli_xxxxxxxx
FEISHU_APP_SECRET=xxxxxxxx

# 后端 API
APP_HOST=0.0.0.0
APP_PORT=7354
APP_DEBUG=false

# 超级管理员解锁口令（侧栏手势兑换 SUPER_ADMIN JWT）；兼容旧名 ADMIN_TOKEN
ADMIN_TOKEN=change-me-to-a-long-random-string
SUPER_ADMIN_TOKEN=

# 用户/超管 JWT（必填）
JWT_SECRET=change-me-to-a-long-random-jwt-secret
JWT_EXPIRE_SECONDS=604800

# 前端（CORS 与媒体 URL）
# 推荐同域：API_PUBLIC_BASE 与 FRONTEND_ORIGIN 相同；/api 由前端反代或 Tunnel 路径分流
FRONTEND_PORT=7355
FRONTEND_ORIGIN=http://127.0.0.1:7355
API_PUBLIC_BASE=http://127.0.0.1:7355

# 数据库
DATABASE_URL=sqlite+aiosqlite:///./data/app.db

# 本地存储根目录
STORAGE_ROOT=./data/meetings

# 飞书用户 OAuth（搜索妙记列表必需 user_access_token）
# 回调按当前访问 URL 动态选择；URIS 为白名单（逗号分隔），飞书开放平台需全部登记
FEISHU_OAUTH_TOKEN_URL=https://accounts.feishu.cn/oauth/v3/token
FEISHU_OAUTH_REDIRECT_URI=http://127.0.0.1:7355/api/v1/auth/feishu/callback
FEISHU_OAUTH_REDIRECT_URIS=http://127.0.0.1:7355/api/v1/auth/feishu/callback,http://127.0.0.1:7354/api/v1/auth/feishu/callback,https://larkmeeting.example.com/api/v1/auth/feishu/callback
FEISHU_OAUTH_SCOPES=minutes:minutes.search:read minutes:minutes.basic:read minutes:minutes.media:export minutes:minutes.transcript:export offline_access
# 飞书 SSO 建号是否要求邀请码（false=开放建号；true 时登录页飞书入口需带 invite）
FEISHU_SSO_REQUIRE_INVITE=false

# 纪要生成 LLM（密钥与模型名常驻 .env）
LLM_BASE_URL=https://api.stepfun.com/step_plan
LLM_API_KEY=sk-xxxxxxxx
LLM_MODEL=step-explore
# 场景判定专用（轻量分类），留空则用 LLM_MODEL
LLM_SCENE_MODEL=step-3.7-flash

# 自建转写（飞书免费版只转前几分钟时兜底）；密钥留空则复用 LLM_API_KEY
STEP_ASR_BASE_URL=https://api.stepfun.com
STEP_ASR_API_KEY=
STEP_ASR_MODEL=stepaudio-2.5-asr
# 声纹嵌入模型；用 scripts/download_speaker_model.py 下载
SPEAKER_EMBEDDING_MODEL_PATH=models/3dspeaker_speech_campplus_sv_zh-cn_16k-common.onnx

# 本机 ffmpeg（路径类基础设施）
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Cloudflare R2（密钥与桶常驻 .env；Dashboard → R2 → Create bucket → API Tokens）
R2_ENABLED=false
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=larkmeeting-share

# ========== 配置表种子（首次启动写入 system_configs，之后以超管「系统配置」页为准）==========

# 大模型调用参数
# 0 = 不限制（按平台上限）；需要截断时再填具体数值
LLM_MAX_TOKENS=0
LLM_TIMEOUT_SECONDS=600
LLM_MAX_ATTEMPTS=5
LLM_CONCURRENCY=20

# 下载队列并发
DOWNLOAD_CONCURRENCY=5

# 下载完成后自动生成纪要
SUMMARY_AUTO_GENERATE=true

# 妙记生成事件早于转写就绪时的重试（错误码 2091003）
MINUTE_READY_MAX_ATTEMPTS=8
MINUTE_READY_RETRY_SECONDS=15

# 带配图的纪要（仅对有视频的会议生效）
SUMMARY_ILLUSTRATE=true
# 配图上限：1 小时内最多 20 张；之后每多半小时 +6（不足半小时按半小时）
SUMMARY_FIGURES_FIRST_HOUR=20
SUMMARY_FIGURES_PER_EXTRA_HALF_HOUR=6
SUMMARY_FIGURE_BATCH_SIZE=6
# 成文前：扫描敏感信息 -> 马赛克打码 -> 复核（最多重盖次数）
SUMMARY_REDACT=true
SUMMARY_REDACT_MAX_ATTEMPTS=3
SUMMARY_REDACT_MOSAIC_BLOCK=12

# 抽帧
FRAME_MAX_WIDTH=1920
FRAME_JPEG_QUALITY=3
FRAME_BURST_OFFSETS=-2,1,4,8
FRAME_REGRAB_LIMIT=3

# 自建转写与声纹
# 末条时间戳不足录音时长的 90%，判定为免费版截断，改走自建转写
STEP_ASR_ENABLED=true
TRANSCRIPT_COVERAGE_THRESHOLD=0.9
ASR_POLL_INTERVAL_SECONDS=3
ASR_MAX_WAIT_SECONDS=1800
ASR_MAX_ATTEMPTS=3
# 余弦相似度高于该值认作同一个人；实测同人质心最低 0.68、异人最高 0.42
SPEAKER_MATCH_THRESHOLD=0.55
SPEAKER_SAMPLE_COUNT=4
SPEAKER_SAMPLE_SECONDS=8
SPEAKER_MIN_SEGMENT_SECONDS=12

# R2 业务阈值（画质 / TTL；密钥见上方）
R2_SIGNED_URL_TTL_SECONDS=7200
R2_VIDEO_CRF=32
R2_VIDEO_MAX_HEIGHT=720
R2_VIDEO_PRESET=veryfast
R2_VIDEO_COMPRESS_TIMEOUT_SECONDS=21600

# 导出 PDF/Word 水印（空=不加水印；首次写入 system_configs）
EXPORT_WATERMARK_TEXT=
